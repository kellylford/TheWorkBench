<Window x:Class="HyperVManage.Views.NewVmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Virtual Machine" Width="600" Height="640" MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">

        <!-- The form -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowForm, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="Builds a Windows VM with an unattended install and leaves it ready to sign in to with Remote Desktop. It takes 15 to 30 minutes and needs nothing from you once it starts."/>

                <Label Content="VM _name:" Target="{Binding ElementName=NameBox}" Padding="0,0,0,2"/>
                <TextBox x:Name="NameBox" AutomationProperties.Name="VM name" Text="{Binding VmName, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Content="Windows _ISO:" Target="{Binding ElementName=IsoBox}" Padding="0,8,0,2"/>
                <DockPanel>
                    <Button Content="_Browse…" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,0" Click="Browse_Click"/>
                    <TextBox x:Name="IsoBox" AutomationProperties.Name="Windows ISO" Text="{Binding IsoPath, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.HelpText="Leave empty to use the newest Windows ISO in your Downloads folder."/>
                </DockPanel>

                <Label Content="_Edition:" Target="{Binding ElementName=EditionBox}" Padding="0,8,0,2"/>
                <TextBox x:Name="EditionBox" AutomationProperties.Name="Edition" Text="{Binding Edition, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Content="_User name:" Target="{Binding ElementName=UserBox}" Padding="0,8,0,2"/>
                <TextBox x:Name="UserBox" AutomationProperties.Name="User name" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Content="Pass_word:" Target="{Binding ElementName=PasswordBox}" Padding="0,8,0,2"/>
                <TextBox x:Name="PasswordBox" AutomationProperties.Name="Password" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.HelpText="Shown as you type. It is saved in Windows Credential Manager so Remote Desktop signs in on its own."/>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <Label Content="_Processors:" Target="{Binding ElementName=CpuBox}" Padding="0,0,0,2"/>
                        <TextBox x:Name="CpuBox" AutomationProperties.Name="Processors" Text="{Binding Processors, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,6,0">
                        <Label Content="_Memory in GB:" Target="{Binding ElementName=MemoryBox}" Padding="0,0,0,2"/>
                        <TextBox x:Name="MemoryBox" AutomationProperties.Name="Memory in GB" Text="{Binding MemoryGB, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Label Content="_Disk in GB:" Target="{Binding ElementName=DiskBox}" Padding="0,0,0,2"/>
                        <TextBox x:Name="DiskBox" AutomationProperties.Name="Disk in GB" Text="{Binding DiskGB, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.HelpText="The disk only takes up the space Windows actually uses."/>
                    </StackPanel>
                </Grid>

                <GroupBox Header="Network" Padding="8" Margin="0,10,0,0" AutomationProperties.Name="Network">
                    <!-- One tab stop; the arrows move between the two and choose as they go. -->
                    <StackPanel KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
                        <RadioButton GroupName="Network" IsChecked="{Binding OnYourNetwork}" GotKeyboardFocus="Radio_GotKeyboardFocus"
                                     Content="Your network: other computers can connect (recommended)"
                                     ToolTip="Uses an external switch, creating one if there isn't one yet. This PC's connection drops for a few seconds when it is created."/>
                        <RadioButton GroupName="Network" IsChecked="{Binding HostOnly}" GotKeyboardFocus="Radio_GotKeyboardFocus" Margin="0,4,0,0"
                                     Content="This PC only (Default Switch)"/>
                    </StackPanel>
                </GroupBox>

                <CheckBox Content="_Start the VM whenever this PC starts" Margin="0,10,0,0" IsChecked="{Binding AutoStart}"/>
                <CheckBox Content="_Open Remote Desktop when it's ready" Margin="0,6,0,0" IsChecked="{Binding ConnectWhenDone}"/>

                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="Firebrick" Margin="0,10,0,0"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="_Create" IsDefault="True" MinWidth="80" Margin="0,0,8,0" Command="{Binding CreateCommand}"/>
                    <Button Content="Cancel" MinWidth="80" Click="Close_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Progress: the script's own output, line by line -->
        <DockPanel Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="CloseButton" Content="C_lose" MinWidth="80" Click="Close_Click"/>
            </StackPanel>
            <Label DockPanel.Dock="Top" Content="Pro_gress:" Target="{Binding ElementName=LogBox}" Padding="0,0,0,2"/>
            <TextBox x:Name="LogBox" AutomationProperties.Name="Progress" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"
                     TextChanged="LogBox_TextChanged"/>
        </DockPanel>
    </Grid>
</Window>
