<Window x:Class="HyperVManage.Views.ApplyCheckpointWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="14">
        <Label Content="_Checkpoint to go back to:" Target="{Binding ElementName=CheckpointList}" Padding="0,0,0,4"/>
        <!-- Each item's name is its ToString: name, when it was taken, and whether it is the one
             the VM is now based on. -->
        <ListBox x:Name="CheckpointList" AutomationProperties.Name="Checkpoint to go back to"
                 Height="160"/>
        <TextBlock x:Name="NoteText" TextWrapping="Wrap" Margin="0,10,0,0"/>
        <CheckBox x:Name="SaveFirstBox" IsChecked="True" Margin="0,10,0,0"
                  Content="_First keep how it is now as a checkpoint, so you can come back to it"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="_Apply" IsDefault="True" MinWidth="80" Margin="0,0,8,0" Click="Apply_Click"/>
            <Button Content="Cancel" IsCancel="True" MinWidth="80"/>
        </StackPanel>
    </StackPanel>
</Window>
