<Window x:Class="HyperVManage.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="14">
        <Label x:Name="PromptLabel" Target="{Binding ElementName=AnswerBox}" Padding="0,0,0,4"/>
        <TextBox x:Name="AnswerBox"/>
        <TextBlock x:Name="NoteText" TextWrapping="Wrap" Margin="0,10,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkButton" IsDefault="True" MinWidth="80" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button Content="Cancel" IsCancel="True" MinWidth="80"/>
        </StackPanel>
    </StackPanel>
</Window>
