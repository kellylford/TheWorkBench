<Window x:Class="HyperVManage.Views.VmSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="14">

        <GroupBox Header="Hardware" Padding="8">
            <StackPanel>
                <TextBlock Text="{Binding HardwareNote}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="{Binding HasHardwareNote, Converter={StaticResource BoolToVisibility}}"/>
                <Label Content="_Processors:" Target="{Binding ElementName=ProcessorsBox}" Padding="0,0,0,2"/>
                <!-- Read-only rather than disabled while the VM runs: a disabled box is skipped by
                     Tab, and the current value should still be reachable. -->
                <TextBox x:Name="ProcessorsBox" AutomationProperties.Name="Processors" Text="{Binding Processors, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding HardwareIsReadOnly}" AutomationProperties.HelpText="{Binding HardwareNote}"/>
                <Label Content="Startup _memory in GB:" Target="{Binding ElementName=MemoryBox}" Padding="0,8,0,2"/>
                <TextBox x:Name="MemoryBox" AutomationProperties.Name="Startup memory in GB" Text="{Binding MemoryGB, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding HardwareIsReadOnly}" AutomationProperties.HelpText="{Binding HardwareNote}"/>
                <CheckBox Content="_Dynamic memory: grow and shrink as Windows needs" Margin="0,8,0,0"
                          IsChecked="{Binding DynamicMemory}" IsEnabled="{Binding CanChangeHardware}"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Network" Padding="8" Margin="0,10,0,0">
            <StackPanel>
                <Label Content="_Network:" Target="{Binding ElementName=SwitchBox}" Padding="0,0,0,2"/>
                <ComboBox x:Name="SwitchBox" AutomationProperties.Name="Network" ItemsSource="{Binding Switches}" SelectedItem="{Binding SelectedSwitch}"/>
                <StackPanel Visibility="{Binding HasNoExternalSwitch, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
                    <TextBlock TextWrapping="Wrap"
                               Text="No switch reaches your own network, so other computers can't connect to this VM. Creating one drops this PC's network connection for a few seconds."/>
                    <Button Content="Create a switch on _your network" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="8,2"
                            Command="{Binding CreateExternalSwitchCommand}"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Starting and checkpoints" Padding="8" Margin="0,10,0,0">
            <StackPanel>
                <Label Content="_Start with this PC:" Target="{Binding ElementName=StartBox}" Padding="0,0,0,2"/>
                <ComboBox x:Name="StartBox" AutomationProperties.Name="Start with this PC" ItemsSource="{Binding StartOptions}" SelectedItem="{Binding StartOption}"/>
                <CheckBox Content="Take a _checkpoint automatically each time the VM starts" Margin="0,8,0,0"
                          IsChecked="{Binding AutomaticCheckpoints}"/>
            </StackPanel>
        </GroupBox>

        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="Firebrick" Margin="0,10,0,0"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Sa_ve" IsDefault="True" MinWidth="80" Margin="0,0,8,0" Command="{Binding SaveCommand}"/>
            <Button Content="Cancel" IsCancel="True" MinWidth="80"/>
        </StackPanel>
    </StackPanel>
</Window>
