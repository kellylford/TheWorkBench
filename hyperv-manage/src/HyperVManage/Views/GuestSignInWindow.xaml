<Window x:Class="HyperVManage.Views.GuestSignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="14">
        <TextBlock x:Name="WhyText" TextWrapping="Wrap" Margin="0,0,0,10" FontWeight="SemiBold"/>
        <TextBlock x:Name="NoteText" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <Label Content="_User name:" Target="{Binding ElementName=UserBox}" Padding="0,0,0,2"/>
        <TextBox x:Name="UserBox" AutomationProperties.Name="User name"
                 AutomationProperties.HelpText="An administrator account in the VM."/>
        <Label Content="_Password:" Target="{Binding ElementName=PasswordBox}" Padding="0,8,0,2"/>
        <PasswordBox x:Name="PasswordBox" AutomationProperties.Name="Password"
                     AutomationProperties.HelpText="Of an administrator account in the VM."/>
        <CheckBox x:Name="RememberBox" Content="_Remember it for this VM" IsChecked="True" Margin="0,10,0,0"
                  AutomationProperties.HelpText="Kept in Windows Credential Manager, for your account only."/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Sign _In" IsDefault="True" MinWidth="80" Margin="0,0,8,0" Click="SignIn_Click"/>
            <Button x:Name="OwnScreenButton" Content="Use the VM's _Own Screen" IsCancel="True" Padding="8,0"/>
        </StackPanel>
    </StackPanel>
</Window>
